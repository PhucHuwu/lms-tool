{
  "manifest_version": 3,
  "name": "LMS Video Status Checker",
  "version": "1.0.0",
  "description": "Theo dõi trạng thái phát video Plyr trên lms.ptit.edu.vn.",
  "permissions": ["activeTab", "scripting", "power"],
  "host_permissions": ["https://lms.ptit.edu.vn/*"],
  "content_scripts": [
    {
      "matches": ["https://lms.ptit.edu.vn/*"],
      "js": ["visibility-override.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    },
    {
      "matches": ["https://lms.ptit.edu.vn/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "LMS Video Status",
    "default_popup": "popup.html"
  }
}
